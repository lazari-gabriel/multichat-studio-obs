# ============================================================================
# MULTICHAT STUDIO PRO — VARIÁVEIS DE AMBIENTE (.env)
# Copie este arquivo para .env e preencha as credenciais OAuth das plataformas
# ============================================================================

PORT=3333
APP_URL=http://localhost:3333
SESSION_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria-64-chars

# ----------------------------------------------------------------------------
# 1. TWITCH OAUTH 2.0
# Obtenha em: https://dev.twitch.tv/console/apps
# Adicione a URL de Redirecionamento (OAuth Redirect URL):
#   http://localhost:3333/api/auth/callback/twitch
#   (e https://seu-dominio.onrender.com/api/auth/callback/twitch em produção)
# ----------------------------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3333/api/auth/callback/twitch

# ----------------------------------------------------------------------------
# 2. KICK OAUTH 2.1 (PKCE S256)
# Obtenha em: https://kick.com/settings/developer (Aba Developer / Apps)
# Documentação: https://docs.kick.com/getting-started/kick-apps-setup
# Adicione a Redirect URI:
#   http://localhost:3333/api/auth/callback/kick
#   (e https://seu-dominio.onrender.com/api/auth/callback/kick em produção)
# Escopos utilizados: user:read channel:read
# ----------------------------------------------------------------------------
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3333/api/auth/callback/kick

# ----------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 / OPENID CONNECT + YOUTUBE LIVE (YouTube Data API v3)
# Obtenha em: https://console.cloud.google.com/apis/credentials
# Crie um "ID do cliente OAuth 2.0" (Aplicativo da Web) e adicione em URIs de redirecionamento:
#   http://localhost:3333/api/auth/callback/google
#   (e https://seu-dominio.onrender.com/api/auth/callback/google em produção)
# Para vincular YouTube Live, ative também a "YouTube Data API v3" no mesmo projeto do Google Cloud.
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/auth/callback/google

# ----------------------------------------------------------------------------
# 4. TIKTOK OAUTH 2.0 (TikTok Login Kit)
# Obtenha em: https://developers.tiktok.com/ (Produto: Login Kit)
# Adicione a Redirect URI:
#   http://localhost:3333/api/auth/callback/tiktok
#   (e https://seu-dominio.onrender.com/api/auth/callback/tiktok em produção)
# ----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3333/api/auth/callback/tiktok
TIKTOK_SCOPE=user.info.basic
